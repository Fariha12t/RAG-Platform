# ---- storage ----
DATABASE_URL=sqlite:///./storage/rag.db          # docker-compose overrides this with PostgreSQL
DATA_DIR=./storage

# ---- bootstrap admin (CHANGE IN PRODUCTION) ----
ADMIN_USERNAME=admin
ADMIN_API_KEY=dev-admin-key

# ---- LLM: extractive (offline, no key) | anthropic | openai ----
LLM_PROVIDER=extractive
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- retrieval: hashing (offline) | sbert | openai ----
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_BACKEND=numpy                              # numpy | faiss
RERANKER_BACKEND=lexical                          # lexical | cross-encoder | none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- ingestion ----
CHUNK_SIZE=900
CHUNK_OVERLAP=150
OCR_ENABLED=true
MAX_UPLOAD_MB=50

# ---- cost tracking: USD per 1M tokens [input, output]; verify against your provider's pricing ----
# PRICING_JSON={"claude-sonnet-5-5":[3.0,15.0]}
